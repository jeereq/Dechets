# ---------------------------------------------------------------------------
# Copiez ce fichier en .env a la racine, puis remplissez les valeurs.
# Aucun secret reel ne doit etre commite dans le depot.
# ---------------------------------------------------------------------------

# --- Base de donnees -------------------------------------------------------
DATABASE_URL="postgresql://benime:benime@localhost:5432/benime?schema=public"

# --- API -------------------------------------------------------------------
API_PORT=4000
API_HOST=0.0.0.0
# Origines autorisees a appeler l'API, separees par des virgules.
CORS_ORIGINS="http://localhost:3000"

# --- Site web --------------------------------------------------------------
NEXT_PUBLIC_API_URL="http://localhost:4000"
# Adresse publique du site : sert aux liens canoniques, au plan du site (sitemap.xml)
# et au partage sur les reseaux. A remplacer par le vrai domaine en production.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# --- Coordonnees affichees sur le site -------------------------------------
NEXT_PUBLIC_PHONE_1="+243 823 678 354"
NEXT_PUBLIC_PHONE_2="+243 974 046 459"
NEXT_PUBLIC_EMAIL="benimecongo.sarl@gmail.com"

# --- FlexPay (mobile money et carte) ---------------------------------------
# A demander a FlexPay pour le compte marchand BENIME CONGO.
FLEXPAY_BASE_URL="https://backend.flexpay.cd/api/rest/v1"
FLEXPAY_MERCHANT=""
FLEXPAY_TOKEN=""
FLEXPAY_CALLBACK_URL="http://localhost:4000/webhooks/flexpay"

# --- Passerelle SMS --------------------------------------------------------
SMS_PROVIDER="mock"           # mock | <nom du fournisseur>
SMS_API_URL=""
SMS_API_KEY=""
SMS_SENDER_ID="BENIME"

# --- WhatsApp (pas encore ouvert) ------------------------------------------
WHATSAPP_PROVIDER="mock"      # mock | meta-cloud
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_TOKEN=""

# --- Sessions (API) ---
# Obligatoire en production : au moins 32 caracteres aleatoires.
# Generer avec : node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
SESSION_JOURS=30

# --- FlexPay : rappel et carte ---
# Adresse de rappel a donner a FlexPay : https://<api>/webhooks/flexpay?cle=<FLEXPAY_CALLBACK_SECRET>
FLEXPAY_CALLBACK_SECRET=
FLEXPAY_CARD_URL=https://cardpayment.flexpay.cd/v1.1/pay
# Site public, ou le client revient apres un paiement par carte
SITE_URL=http://localhost:3000
