{
  "name": "benime-assainissement",
  "private": true,
  "version": "0.1.0",
  "description": "BENIME CONGO Assainissement — site public, application des menages et des agents, back-office et API",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter \"./apps/*\" dev",
    "dev:web": "pnpm --filter @benime/web dev",
    "dev:api": "pnpm --filter @benime/api dev",
    "build": "pnpm --filter @benime/shared build && pnpm --filter @benime/api build && pnpm --filter @benime/web build",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "db:up": "docker compose up -d postgres",
    "db:migrate": "pnpm --filter @benime/api prisma:migrate",
    "db:seed": "pnpm --filter @benime/api prisma:seed",
    "postinstall": "pnpm --filter @benime/shared build"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/client",
      "prisma",
      "@prisma/engines",
      "esbuild"
    ]
  },
  "dependencies": {
    "next": "^15.0.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  }
}
